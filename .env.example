# ═══════════════════════════════════════════════════════════════
#  Klex — Single .env for ALL services (Django, Java, Docker)
# ═══════════════════════════════════════════════════════════════
# Copy this file:  cp .env.example .env
# Then fill in your real values below.

# ── Database ──────────────────────────────────────────────────
# Django-style URL (used by Django + auto-converted for Java)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/klex

# These are used by the Postgres Docker container.
# Keep them in sync with DATABASE_URL above.
POSTGRES_DB=klex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Django ────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── GitHub OAuth ──────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# ── Python ────────────────────────────────────────────────────
UV_PYTHON_VERSION=3.11

# ── Java Compiler / Reporting Service ─────────────────────────
COMPILER_SERVICE_URL=http://localhost:8081

# ── Spring / Java Datasource (Optional Override) ─────────────
# Normally auto-derived from DATABASE_URL by start.sh / entrypoint.sh.
# Uncomment only if you need to point Java at a different DB.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/klex
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# ── SMTP / Mail (for scheduled report email delivery) ────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# Comma-separated emails for failure notifications (defaults to SPRING_MAIL_USERNAME)
FAILURE_NOTIFICATION_EMAIL=your-email@gmail.com

# ── Apache Airflow (Job Scheduling) ───────────────────────────
AIRFLOW_AUTOSTART=false
AIRFLOW_API_URL=http://localhost:8080/api/v1
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# ── Report Data Sources ──────────────────────────────────────
# Referenced by datasource YAML files in report repositories.
# Add env vars matching the ${...} placeholders in your YAML files.
# DB_USER_SALES_DB=postgres
# DB_PASSWORD_SALES_DB=secret

# ── OpenRouter / Chatbot ─────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ring-2.6-1t:free

